# Trading Engine v1 local/runtime configuration example.
# Copy to `.env`, then fill secrets and enable live toggles only during an intentional live session.

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./trading.db
EVENT_BACKEND=memory

# Binance credentials. Keep live trading disabled until final manual signoff.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TRADE_LIVE_ENABLED=false
BINANCE_LIVE_POSITION_SIDE_MODE=ONE_WAY
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binancefuture.com/stream

# Current MICRO_LIVE shape. Keep live submit disabled until final manual signoff.
AUTO_TRADING_ENABLED=false
AUTO_TRADING_EXECUTION_MODE=MICRO_LIVE
UNIVERSE_NAME=micro_live_usdt_11
AUTO_TRADING_ALLOWED_SYMBOLS=ADAUSDT,ATOMUSDT,BTCUSDT,FETUSDT,INJUSDT,LINKUSDT,LTCUSDT,NEARUSDT,RUNEUSDT,SUIUSDT,ZECUSDT
AUTO_TRADING_ALLOWED_FAMILIES=session_impulse_retest
AUTO_TRADING_CLOSE_ONLY=true
AUTO_TRADING_REQUIRE_VALIDATION_GO=true
AUTO_TRADING_MAX_SLIPPAGE_BPS=12

# Uses recent 3-year USDT proxy replay proof for session_impulse_retest when live DB validation sample is still missing.
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_ENABLED=true
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_BACKTEST_DIR=reports/validation/micro_main_usdt_proxy_backtests
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_PORTFOLIO_DIR=reports/validation/micro_main_risk_sweeps
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_PORTFOLIO_MIX_REPORT_PATH=reports/operations/micro_intrabar_long_short_portfolio_mix_review_drop_arb/latest.json
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MAX_AGE_DAYS=14
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_DAYS=1000
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_TRADES=80
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_EV_R=0.10
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_WIN_RATE=0.40
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_SCORE=70
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_YEARS=3
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MAX_PORTFOLIO_MDD_PCT=25

# Live sizing. Values are fractions, so 0.01 means 1% account risk.
AUTO_TRADING_LIVE_SIZING_MODE=RISK_PCT
AUTO_TRADING_LIVE_ACCOUNT_EQUITY_USDT=200
AUTO_TRADING_LIVE_BALANCE_SYNC_ENABLED=false
AUTO_TRADING_LIVE_BALANCE_SYNC_ASSETS=USDT,USDC
AUTO_TRADING_LIVE_BALANCE_SYNC_FAIL_CLOSED=true
AUTO_TRADING_LIVE_RISK_PER_TRADE_PCT=0.01
AUTO_TRADING_LIVE_USABLE_MARGIN_FRACTION=0.85
AUTO_TRADING_LIVE_LEVERAGE_CAP=10

# Fail-closed live liquidity gate.
AUTO_TRADING_LIVE_LIQUIDITY_GATE_ENABLED=true
AUTO_TRADING_LIVE_LIQUIDITY_GATE_FAIL_CLOSED=true
AUTO_TRADING_LIVE_LIQUIDITY_GATE_ORDERBOOK_LIMIT=100
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MIN_DEPTH_USDT=50000
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_DEPTH_PARTICIPATION=0.10
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_1M_VOLUME_PARTICIPATION=0.02
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_5M_VOLUME_PARTICIPATION=0.01
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_SPREAD_BPS=8
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_MARKET_SLIPPAGE_BPS=10
AUTO_TRADING_LIVE_LIQUIDITY_GATE_PARTIAL_SUBMIT_ENABLED=true
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_TRANCHES=3
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MIN_TRANCHE_NOTIONAL_USDT=10
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MIN_TRANCHE_TARGET_FRACTION=0.10

# Mandatory live protection. Runtime guard fails closed if these drift off.
AUTO_TRADING_LIVE_PROTECTION_ORDERS_ENABLED=true
AUTO_TRADING_LIVE_STOP_WORKING_TYPE=MARK_PRICE
AUTO_TRADING_LIVE_STOP_PRECHECK_ENABLED=true
AUTO_TRADING_LIVE_STOP_PRECHECK_FAIL_CLOSED=true
AUTO_TRADING_LIVE_STOP_PRECHECK_MIN_CUSHION_BPS=5
AUTO_TRADING_LIVE_STOP_PRECHECK_MIN_TICK_CUSHION=3
AUTO_TRADING_LIVE_STOP_MARK_PRICE_GUARD_ENABLED=true
AUTO_TRADING_LIVE_PROTECTION_FAILURE_FLATTEN_ENABLED=true
AUTO_TRADING_LIVE_PROTECTION_VERIFY_AFTER_ATTACH_ENABLED=true
AUTO_TRADING_LIVE_PROTECTION_VERIFY_FAIL_CLOSED=true
AUTO_TRADING_LIVE_PROTECTION_VERIFY_ATTEMPTS=3
AUTO_TRADING_LIVE_PROTECTION_VERIFY_SLEEP_SECONDS=0.5
AUTO_TRADING_LIVE_TP_LIMIT_ATTACH_ENABLED=true
AUTO_TRADING_LIVE_TAKE_PROFIT_VERIFY_AFTER_ATTACH_ENABLED=true
AUTO_TRADING_LIVE_MISSING_STOP_WATCHDOG_FLATTEN_ENABLED=true
AUTO_TRADING_LIVE_MISSING_STOP_WATCHDOG_CANCEL_OPEN_ORDERS=true
AUTO_TRADING_LIVE_UNEXPECTED_OPEN_ORDER_WATCHDOG_CANCEL_ENABLED=true
AUTO_TRADING_LIVE_POSITION_MANAGER_ENABLED=true
AUTO_TRADING_LIVE_BREAKEVEN_AFTER_PARTIAL_ENABLED=true
AUTO_TRADING_LIVE_BREAKEVEN_OFFSET_BPS=0.0
AUTO_TRADING_LIVE_BREAKEVEN_MIN_IMPROVEMENT_BPS=0.0
AUTO_TRADING_LIVE_ADVERSE_VOLUME_EXIT_ENABLED=true
AUTO_TRADING_LIVE_ADVERSE_VOLUME_EXIT_AFTER_PARTIAL_ONLY=false
AUTO_TRADING_LIVE_ADVERSE_VOLUME_EXIT_MIN_FACTOR=3.0
AUTO_TRADING_LIVE_ADVERSE_VOLUME_EXIT_MIN_BODY_R=0.35
AUTO_TRADING_LIVE_ADVERSE_VOLUME_EXIT_LOOKBACK_BARS=20

# MICRO_LIVE live pacing. The total position cap remains the primary exposure brake.
AUTO_TRADING_LIVE_FAMILY_CLUSTER_WINDOW_MINUTES=30
AUTO_TRADING_LIVE_MAX_SAME_FAMILY_ENTRIES_PER_WINDOW=2
AUTO_TRADING_LIVE_MAX_SAME_FAMILY_DIRECTION_EXPOSURES=2
AUTO_TRADING_LIVE_RECENT_LOSS_COOLDOWN_MINUTES=60
AUTO_TRADING_LIVE_RECENT_LOSS_TRIGGER_COUNT=4

# MICRO_LIVE allowlists.
AUTO_TRADING_MICRO_LIVE_ALLOWED_SYMBOLS=ADAUSDT,ATOMUSDT,BTCUSDT,FETUSDT,INJUSDT,LINKUSDT,LTCUSDT,NEARUSDT,RUNEUSDT,SUIUSDT,ZECUSDT
AUTO_TRADING_MICRO_LIVE_SYMBOL_PRIORITY=ADAUSDT,ATOMUSDT,BTCUSDT,FETUSDT,INJUSDT,LINKUSDT,LTCUSDT,NEARUSDT,RUNEUSDT,SUIUSDT,ZECUSDT
AUTO_TRADING_MICRO_LIVE_DIRECTION_CONTRACT=ADAUSDT:LONG,ATOMUSDT:SHORT,BTCUSDT:LONG,FETUSDT:SHORT,INJUSDT:LONG,LINKUSDT:LONG,LTCUSDT:SHORT,NEARUSDT:SHORT,RUNEUSDT:SHORT,SUIUSDT:SHORT,ZECUSDT:SHORT
AUTO_TRADING_MICRO_LIVE_ALLOWED_FAMILIES=session_impulse_retest
AUTO_TRADING_MICRO_LIVE_ALLOWED_ENTRY_MODELS=CONFIRM
AUTO_TRADING_MICRO_LIVE_MAX_CONCURRENT_POSITIONS=2
AUTO_TRADING_MICRO_LIVE_MAX_DAILY_NEW_ENTRIES=0
AUTO_TRADING_MICRO_LIVE_ALLOWED_SESSIONS=dead_session,london,new_york
AUTO_TRADING_MICRO_LIVE_EVENT_BLACKOUT_PATH=reports/validation/contracts/micro_live_event_blackouts_major_us_macro_q2_2026_v1.json
AUTO_TRADING_MICRO_LIVE_EVENT_BLACKOUT_MIN_HORIZON_DAYS=45
AUTO_TRADING_MICRO_LIVE_STRATEGY_TIME_CONTRACT_PATH=
AUTO_TRADING_MICRO_LIVE_PLAN_BLOCKLIST_PATH=

# session_impulse_retest tracks the current USDT 11 MICRO_LIVE route.
SESSION_IMPULSE_RETEST_ENABLED=true
SESSION_IMPULSE_RETEST_SHADOW_ONLY=false
SESSION_IMPULSE_RETEST_PARTIAL_ACTIVATION_RATIO=1.00
SESSION_IMPULSE_RETEST_CORE_LIVE_SLOTS=29
SESSION_IMPULSE_RETEST_SECONDARY_LIVE_ENABLED=false
SESSION_IMPULSE_RETEST_SATURDAY_RISK_MULTIPLIER=1.0
SESSION_IMPULSE_RETEST_ALLOWED_SYMBOLS=ADAUSDT,ATOMUSDT,BTCUSDT,FETUSDT,INJUSDT,LINKUSDT,LTCUSDT,NEARUSDT,RUNEUSDT,SUIUSDT,ZECUSDT
SESSION_IMPULSE_RETEST_ENTRY_TIMING_MODEL=intrabar_1m_confirm_next_open
SESSION_IMPULSE_RETEST_INTRABAR_LONG_SETUP_HOURS_UTC=14
SESSION_IMPULSE_RETEST_INTRABAR_SHORT_SETUP_HOURS_UTC=7
SESSION_IMPULSE_RETEST_INTRABAR_LONG_MIN_RECLAIM_BODY_ATR=0.25
SESSION_IMPULSE_RETEST_INTRABAR_SHORT_MIN_RECLAIM_BODY_ATR=0.0
SESSION_IMPULSE_RETEST_EXIT_POLICY_NAME=structure_buffered_swing6_stop0.12_tpbuf0.08_pm_stop0.00r_advvol_any
SESSION_IMPULSE_RETEST_EXIT_TARGET_RR=2.5
SESSION_IMPULSE_RETEST_EXIT_MAX_HOLD_MINUTES=40
SESSION_IMPULSE_RETEST_EXIT_ENTRY_CONFIRMATION_DELAY_MINUTES=0
SESSION_IMPULSE_RETEST_EXIT_STOP_AFTER_PARTIAL_RR=0.0
SESSION_IMPULSE_RETEST_EXIT_ADVERSE_VOLUME_ENABLED=true
SESSION_IMPULSE_RETEST_EXIT_ADVERSE_VOLUME_AFTER_PARTIAL_ONLY=false
SESSION_IMPULSE_RETEST_EXIT_ADVERSE_VOLUME_MIN_FACTOR=3.0
SESSION_IMPULSE_RETEST_EXIT_ADVERSE_VOLUME_MIN_BODY_R=0.35
SESSION_IMPULSE_RETEST_EXIT_ADVERSE_VOLUME_LOOKBACK_BARS=20

# Exchange rule fallback. Prefer `--check-binance-rules` before live signoff.
BINANCE_LIVE_MIN_QUANTITY=0.001
BINANCE_LIVE_QUANTITY_STEP=0.001

# Runtime readiness. Keep true for live operation; local development can set false explicitly.
READY_REQUIRE_RUNTIME_WORKERS=true
READY_MARKET_DATA_PROBE_SYMBOL=BTCUSDT
RUNTIME_WORKER_HEARTBEAT_DIR=/tmp/trading_worker_heartbeats
VALIDATION_PAYLOAD_CACHE_MAX_AGE_SECONDS=900
VALIDATION_PAYLOAD_CACHE_STALE_ON_DATABASE_CHANGE=false

# Optional alert channels.
VALIDATION_ALERT_CHANNEL=system
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_PUSH_WEBHOOK_URL=
ALERT_PUSH_BEARER_TOKEN=
