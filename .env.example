# Trading Engine v1 local/runtime configuration example.
# Copy to `.env`, then fill secrets and enable live toggles only during an intentional live session.

ENVIRONMENT=dev
DATABASE_URL=sqlite:///./trading.db
EVENT_BACKEND=memory

# Binance credentials. Keep live trading disabled until final manual signoff.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TRADE_LIVE_ENABLED=false
BINANCE_REST_BASE_URL=https://fapi.binance.com
BINANCE_WS_BASE_URL=wss://fstream.binancefuture.com/stream

# Current MICRO_LIVE shape. Keep live submit disabled until final manual signoff.
AUTO_TRADING_ENABLED=false
AUTO_TRADING_EXECUTION_MODE=MICRO_LIVE
AUTO_TRADING_ALLOWED_SYMBOLS=BTCUSDC,ETHUSDC,SOLUSDC,LINKUSDC,BNBUSDC,XRPUSDC,ADAUSDC,AVAXUSDC,BCHUSDC,LTCUSDC,NEARUSDC
AUTO_TRADING_ALLOWED_FAMILIES=sweep_reversal,session_impulse_retest
AUTO_TRADING_CLOSE_ONLY=false
AUTO_TRADING_REQUIRE_VALIDATION_GO=true
AUTO_TRADING_MAX_SLIPPAGE_BPS=12

# Uses recent 3-year USDT proxy replay proof for session_impulse_retest when live DB validation sample is still missing.
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_ENABLED=true
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_BACKTEST_DIR=reports/validation/micro_main_usdt_proxy_backtests
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_PORTFOLIO_DIR=reports/validation/micro_main_risk_sweeps
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MAX_AGE_DAYS=14
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_DAYS=1000
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_TRADES=80
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_EV_R=0.10
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_WIN_RATE=0.40
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_SCORE=70
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MIN_YEARS=3
AUTO_TRADING_REPLAY_VALIDATION_BRIDGE_MAX_PORTFOLIO_MDD_PCT=25

# Live sizing. Values are fractions, so 0.01 means 1% account risk.
AUTO_TRADING_LIVE_SIZING_MODE=RISK_PCT
AUTO_TRADING_LIVE_ACCOUNT_EQUITY_USDT=200
AUTO_TRADING_LIVE_RISK_PER_TRADE_PCT=0.01
AUTO_TRADING_LIVE_USABLE_MARGIN_FRACTION=0.85
AUTO_TRADING_LIVE_LEVERAGE_CAP=10

# Fail-closed live liquidity gate.
AUTO_TRADING_LIVE_LIQUIDITY_GATE_ENABLED=true
AUTO_TRADING_LIVE_LIQUIDITY_GATE_FAIL_CLOSED=true
AUTO_TRADING_LIVE_LIQUIDITY_GATE_ORDERBOOK_LIMIT=100
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MIN_DEPTH_USDT=50000
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_DEPTH_PARTICIPATION=0.10
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_1M_VOLUME_PARTICIPATION=0.02
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_5M_VOLUME_PARTICIPATION=0.01
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_SPREAD_BPS=8
AUTO_TRADING_LIVE_LIQUIDITY_GATE_MAX_MARKET_SLIPPAGE_BPS=10
AUTO_TRADING_LIVE_LIQUIDITY_GATE_PARTIAL_SUBMIT_ENABLED=false

# MICRO_LIVE allowlists and pacing.
AUTO_TRADING_MICRO_LIVE_ALLOWED_SYMBOLS=BTCUSDC,ETHUSDC,SOLUSDC,LINKUSDC,BNBUSDC,XRPUSDC,ADAUSDC,AVAXUSDC,BCHUSDC,LTCUSDC,NEARUSDC
AUTO_TRADING_MICRO_LIVE_SYMBOL_PRIORITY=BTCUSDC,ETHUSDC,SOLUSDC,LINKUSDC,BNBUSDC,XRPUSDC,ADAUSDC,AVAXUSDC,BCHUSDC,LTCUSDC,NEARUSDC
AUTO_TRADING_MICRO_LIVE_DIRECTION_CONTRACT=BTCUSDC:LONG|SHORT,ETHUSDC:LONG|SHORT,SOLUSDC:LONG|SHORT,LINKUSDC:LONG|SHORT,BNBUSDC:LONG|SHORT,XRPUSDC:LONG|SHORT,ADAUSDC:LONG|SHORT,AVAXUSDC:LONG|SHORT,BCHUSDC:LONG|SHORT,LTCUSDC:LONG|SHORT,NEARUSDC:LONG|SHORT
AUTO_TRADING_MICRO_LIVE_ALLOWED_FAMILIES=sweep_reversal,session_impulse_retest
AUTO_TRADING_MICRO_LIVE_ALLOWED_ENTRY_MODELS=LIMIT,CONFIRM
AUTO_TRADING_MICRO_LIVE_MAX_CONCURRENT_POSITIONS=2
AUTO_TRADING_MICRO_LIVE_MAX_DAILY_NEW_ENTRIES=0
AUTO_TRADING_MICRO_LIVE_ALLOWED_SESSIONS=
AUTO_TRADING_MICRO_LIVE_EVENT_BLACKOUT_PATH=reports/validation/contracts/micro_live_event_blackouts_major_us_macro_q2_2026_v1.json
AUTO_TRADING_MICRO_LIVE_EVENT_BLACKOUT_MIN_HORIZON_DAYS=45
AUTO_TRADING_MICRO_LIVE_STRATEGY_TIME_CONTRACT_PATH=
AUTO_TRADING_MICRO_LIVE_PLAN_BLOCKLIST_PATH=

# session_impulse_retest tracks secondary symbols for observation; only core symbols above are MICRO_LIVE.
SESSION_IMPULSE_RETEST_ENABLED=true
SESSION_IMPULSE_RETEST_SHADOW_ONLY=false
SESSION_IMPULSE_RETEST_ALLOWED_SYMBOLS=BTCUSDC,ETHUSDC,SOLUSDC,BNBUSDC,XRPUSDC,ADAUSDC,AVAXUSDC,LINKUSDC,SUIUSDC,BCHUSDC,LTCUSDC,NEARUSDC,AAVEUSDC,XLMUSDC,HBARUSDC
SESSION_IMPULSE_RETEST_SECONDARY_LIVE_ENABLED=false

# Exchange rule fallback. Prefer `--check-binance-rules` before live signoff.
BINANCE_LIVE_MIN_QUANTITY=0.001
BINANCE_LIVE_QUANTITY_STEP=0.001

# Runtime readiness. Keep true for live operation; local development can set false explicitly.
READY_REQUIRE_RUNTIME_WORKERS=true
READY_MARKET_DATA_PROBE_SYMBOL=BTCUSDC
RUNTIME_WORKER_HEARTBEAT_DIR=/tmp/trading_worker_heartbeats
VALIDATION_PAYLOAD_CACHE_MAX_AGE_SECONDS=900
VALIDATION_PAYLOAD_CACHE_STALE_ON_DATABASE_CHANGE=false

# Optional alert channels.
VALIDATION_ALERT_CHANNEL=system
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_PUSH_WEBHOOK_URL=
ALERT_PUSH_BEARER_TOKEN=
